# App settings. Values starting with EXPO_PUBLIC_ are built into the app, so only put PUBLIC values here
# (never passwords or database strings; those belong in server/.env).
# After changing this file, restart the dev server: npx.cmd expo start --clear

# Address of the deployed Todo backend, used by release builds. While developing, the app finds the
# backend on your PC automatically (same address as the dev server, port 4000), so this can stay as is.
EXPO_PUBLIC_API_URL=http://192.168.1.231:4000

# Google sign-in (Google Cloud > Google Auth Platform > Clients)
# Android client: Google matches it automatically by package name + SHA-1. Kept here for reference only.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=716648589373-2e7uomuqtja235eibbbu7h9hnk9ib3jm.apps.googleusercontent.com
# Web client ID: optional. Only needed later if the backend should verify Google logins.
# Must be a "Web application" client ID, NOT the Android one, or sign-in fails with DEVELOPER_ERROR.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
